# File: biglinux-settings/usr/share/biglinux/biglinux-
# settings/performance_games_page.py, line: 16
msgid "BigLinux performance tweaks."
msgstr "Оптимизации на производителността на BigLinux."

# File: biglinux-settings/usr/share/biglinux/biglinux-
# settings/usability/gamemode_config_dialog.py, line: 91
msgid "Disable Visual Effects"
msgstr "Деактивиране на визуални ефекти"

# File: biglinux-settings/usr/share/biglinux/biglinux-
# settings/performance_games_page.py, line: 35
msgid ""
"Disables KWin visual effects (blur, shadows, animations). Reduces GPU load "
"and frees memory."
msgstr ""
"Деактивира визуалните ефекти на KWin (размазаност, сенки, анимации). "
"Намалява натоварването на GPU и освобождава памет."

# File: biglinux-settings/usr/share/biglinux/biglinux-
# settings/performance_games_page.py, line: 63
msgid "CPU Maximum Performance"
msgstr "Максимална производителност на процесора"

# File: biglinux-settings/usr/share/biglinux/biglinux-
# settings/performance_games_page.py, line: 51
msgid ""
"Forces maximum processor performance mode. Ensures the processor uses "
"maximum frequency."
msgstr ""
"Режим на максимална производителност на процесора. Осигурява, че процесорът "
"използва максимална честота."

# File: biglinux-settings/usr/share/biglinux/biglinux-
# settings/performance_games_page.py, line: 79
msgid "Disable Baloo Indexer"
msgstr "Деактивирайте Baloo индексатора"

# File: biglinux-settings/usr/share/biglinux/biglinux-
# settings/performance_games_page.py, line: 67
msgid "Disables the Baloo file indexer. Avoids disk I/O overhead."
msgstr ""
"Деактивира Baloo файловия индексатор. Избягва натоварването на дисковия вход/"
"изход."

# File: biglinux-settings/usr/share/biglinux/biglinux-
# settings/usability/gamemode_config_dialog.py, line: 136
msgid "Unload S.M.A.R.T Monitor"
msgstr "Разтоварване на S.M.A.R.T монитор"

# File: biglinux-settings/usr/share/biglinux/biglinux-
# settings/performance_games_page.py, line: 83
msgid "Disables S.M.A.R.T disk monitoring. Reduces disk I/O and CPU usage."
msgstr ""
"Деактивира мониторинга на S.M.A.R.T диска. Намалява I/O на диска и "
"използването на CPU."

# File: biglinux-settings/usr/share/biglinux/biglinux-
# settings/system_usability_page.py, line: 169
msgid "Meltdown Mitigations off"
msgstr "Митигиране на Meltdown изключено"

# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 62
msgid "Using mitigations=off will make your machine faster and less secure!"
msgstr ""
"Използването на mitigations=off ще направи вашата машина по-бърза и по-малко "
"сигурна!"

# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 67
msgid ""
"This will disable CPU security mitigations (Meltdown/Spectre). Your system "
"will be faster but vulnerable to hardware-level attacks. Are you sure you "
"want to continue?"
msgstr ""
"Това ще деактивира защитните мерки на процесора (Meltdown/Spectre). Вашата "
"система ще бъде по-бърза, но уязвима на атаки на хардуерно ниво. Сигурни ли "
"сте, че искате да продължите?"

# File: biglinux-settings/usr/share/biglinux/biglinux-
# settings/system_usability_page.py, line: 176
msgid "noWatchdog"
msgstr "безНаблюдател"

# File: biglinux-settings/usr/share/biglinux/biglinux-
# settings/system_usability_page.py, line: 177
msgid ""
"Disables the hardware watchdog and TSC clocksource systems, maintaining high "
"performance but removing automatic protections against system crashes."
msgstr ""
"Деактивира хардуерния watchdog и системите за часови източници TSC, "
"поддържайки висока производителност, но премахвайки автоматичните защити "
"срещу сривове на системата."

# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 81
msgid ""
"This will disable the hardware watchdog. Your system will no longer "
"automatically recover from certain types of crashes. Are you sure you want "
"to continue?"
msgstr ""
"Това ще деактивира хардуерния наблюдател. Вашата система вече няма да се "
"възстановява автоматично от определени видове сривове. Сигурни ли сте, че "
"искате да продължите?"

