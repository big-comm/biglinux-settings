msgid "Sleep Mode"
msgstr "Modo de Suspensão"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:76
msgid "Configure how the system suspends."
msgstr "Configurar como o sistema suspende."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:83
msgid "Use s2idle (light sleep)"
msgstr "Usar s2idle (suspensão leve)"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:85
msgid ""
"Uses a lighter sleep mode that preserves Fn keys and device state. "
"Recommended for ASUS notebooks."
msgstr ""
"Usa um modo de suspensão mais leve que preserva as teclas Fn e o estado do "
"dispositivo. Recomendado para notebooks ASUS."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:91
msgid ""
"S3 deep sleep can cause the Embedded Controller to stop generating hotkey "
"interrupts. s2idle keeps the EC powered, avoiding this issue at a small cost"
" in battery consumption."
msgstr ""
"A suspensão profunda S3 pode fazer com que o Controlador Embarcado pare de "
"gerar interrupções de teclas de atalho. O s2idle mantém o EC alimentado, "
"evitando esse problema com um pequeno custo no consumo de bateria."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:100
msgid "WiFi"
msgstr "WiFi"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:101
msgid "Prevent WiFi issues after suspend."
msgstr "Evitar problemas de WiFi após a suspensão."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:108
msgid "Protect WiFi on suspend"
msgstr "Proteger WiFi na suspensão"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:110
msgid ""
"Prevents the Realtek WiFi chip from fully powering off (d3cold), avoiding "
"connection loss after resume."
msgstr ""
"Impede que o chip WiFi Realtek desligue completamente (d3cold), evitando "
"perda de conexão após a retomada."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:116
msgid ""
"Some Realtek RTL8852BE/CE chips fail to reinitialize after d3cold power "
"gating. This keeps the chip in d3hot (PCIe link alive) during suspend."
msgstr ""
"Alguns chips Realtek RTL8852BE/CE falham ao reinicializar após o bloqueio de"
" energia d3cold. Isso mantém o chip em d3hot (link PCIe ativo) durante a "
"suspensão."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:124
msgid "Display and Keyboard"
msgstr "Tela e Teclado"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:125
msgid "Preserve brightness and LED state across suspend."
msgstr "Preservar o brilho e o estado dos LEDs durante a suspensão."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:132
msgid "Save/restore brightness on suspend"
msgstr "Salvar/restaurar brilho ao suspender"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:134
msgid ""
"Saves screen brightness and keyboard LEDs before suspending and restores "
"them on resume."
msgstr ""
"Salva o brilho da tela e LEDs do teclado antes de suspender e os restaura ao"
" retomar."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:144
msgid "GNOME Shell Extensions"
msgstr "Extensões do GNOME Shell"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:145
msgid "Automatic health check after resume."
msgstr "Verificação automática de integridade após retomar."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:152
msgid "Extension health monitor"
msgstr "Monitor de integridade de extensões"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:154
msgid ""
"Detects GNOME Shell extensions in error state after resume and automatically"
" restarts them."
msgstr ""
"Detecta extensões do GNOME Shell em estado de erro após retomar e as "
"reinicia automaticamente."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:163
msgid "Lid Switch"
msgstr "Tampa do notebook"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:164
msgid "Laptop lid close behavior."
msgstr "Comportamento ao fechar a tampa do notebook."

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:171
msgid "Suspend on lid close (AC power)"
msgstr "Suspender ao fechar a tampa (energia CA)"

#: /home/talesam/Servidor/GitHub/BigCommunity/biglinux-settings/usr/share/biglinux/biglinux-settings/sleep_page.py:173
msgid ""
"Some systems do not suspend when on AC power. This forces suspend when the "
"lid is closed."
msgstr ""
"Alguns sistemas não suspendem quando conectados à energia CA. Isso força a "
"suspensão ao fechar a tampa."
