msgid "Automatic Suspend"
msgstr "Automatic Suspend"

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 73
msgid "Choose when inactivity and low battery may suspend the system."
msgstr "Choose when inactivity and low battery may suspend the system."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 80
msgid "Never suspend while plugged in"
msgstr "Never suspend while plugged in"

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 81
msgid "Disables automatic suspend caused by inactivity on AC power."
msgstr "Disables automatic suspend caused by inactivity on AC power."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 88
msgid "Never suspend on battery due to inactivity"
msgstr "Never suspend on battery due to inactivity"

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 89
msgid "Keeps the system awake on battery until a critical level is reached."
msgstr "Keeps the system awake on battery until a critical level is reached."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 96
msgid "Suspend only when battery reaches 20%"
msgstr "Suspend only when battery reaches 20%"

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 98
msgid ""
"Disables idle suspend on battery and suspends automatically when the charge "
"reaches 20%."
msgstr ""
"Disables idle suspend on battery and suspends automatically when the charge "
"reaches 20%."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 104
msgid ""
"This uses UPower's critical battery policy. Low and critical warnings occur "
"before the suspend action at 20%."
msgstr ""
"This uses UPower's critical battery policy. Low and critical warnings occur "
"before the suspend action at 20%."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 112
msgid "Sleep Mode"
msgstr "Sleep Mode"

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 113
msgid "Configure how the system suspends."
msgstr "Configure how the system suspends."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 120
msgid "Use s2idle (light sleep)"
msgstr "Use s2idle (light sleep)"

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 122
msgid ""
"Uses a lighter sleep mode that preserves Fn keys and device state. "
"Recommended for ASUS notebooks."
msgstr ""
"Uses a lighter sleep mode that preserves Fn keys and device state. "
"Recommended for ASUS notebooks."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 128
msgid ""
"S3 deep sleep can cause the Embedded Controller to stop generating hotkey "
"interrupts. s2idle keeps the EC powered, avoiding this issue at a small cost "
"in battery consumption."
msgstr ""
"S3 deep sleep can cause the Embedded Controller to stop generating hotkey "
"interrupts. s2idle keeps the EC powered, avoiding this issue at a small cost "
"in battery consumption."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 137
msgid "WiFi"
msgstr "WiFi"

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 138
msgid "Prevent WiFi issues after suspend."
msgstr "Prevent WiFi issues after suspend."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 145
msgid "Protect WiFi on suspend"
msgstr "Protect WiFi on suspend"

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 147
msgid ""
"Prevents the Realtek WiFi chip from fully powering off (d3cold), avoiding "
"connection loss after resume."
msgstr ""
"Prevents the Realtek WiFi chip from fully powering off (d3cold), avoiding "
"connection loss after resume."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 153
msgid ""
"Some Realtek RTL8852BE/CE chips fail to reinitialize after d3cold power "
"gating. This keeps the chip in d3hot (PCIe link alive) during suspend."
msgstr ""
"Some Realtek RTL8852BE/CE chips fail to reinitialize after d3cold power "
"gating. This keeps the chip in d3hot (PCIe link alive) during suspend."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 161
msgid "Display and Keyboard"
msgstr "Display and Keyboard"

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 162
msgid "Preserve brightness and LED state across suspend."
msgstr "Preserve brightness and LED state across suspend."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 169
msgid "Save/restore brightness on suspend"
msgstr "Save/restore brightness on suspend"

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 171
msgid ""
"Saves screen brightness and keyboard LEDs before suspending and restores "
"them on resume."
msgstr ""
"Saves screen brightness and keyboard LEDs before suspending and restores "
"them on resume."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 181
msgid "GNOME Shell Extensions"
msgstr "GNOME Shell Extensions"

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 182
msgid "Automatic health check after resume."
msgstr "Automatic health check after resume."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 189
msgid "Extension health monitor"
msgstr "Extension health monitor"

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 191
msgid ""
"Detects GNOME Shell extensions in error state after resume and automatically "
"restarts them."
msgstr ""
"Detects GNOME Shell extensions in error state after resume and automatically "
"restarts them."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 200
msgid "Lid Switch"
msgstr "Lid Switch"

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 201
msgid "Laptop lid close behavior."
msgstr "Laptop lid close behavior."

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 208
msgid "Suspend on lid close (AC power)"
msgstr "Suspend on lid close (AC power)"

#
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 210
msgid ""
"Some systems do not suspend when on AC power. This forces suspend when the "
"lid is closed."
msgstr ""
"Some systems do not suspend when on AC power. This forces suspend when the "
"lid is closed."

