#
# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 22
msgid "Disable Visual Effects"
msgstr "Disable Visual Effects"

#
# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 24
msgid ""
"Disables KWin visual effects (blur, shadows, animations). Reduces GPU load "
"and frees memory."
msgstr ""
"Disables KWin visual effects (blur, shadows, animations). Reduces GPU load "
"and frees memory."

#
# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 32
msgid "CPU Maximum Performance"
msgstr "CPU Maximum Performance"

#
# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 34
msgid ""
"Forces maximum processor performance mode. Ensures the processor uses "
"maximum frequency."
msgstr ""
"Forces maximum processor performance mode. Ensures the processor uses "
"maximum frequency."

#
# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 42
msgid "Disable Baloo Indexer"
msgstr "Disable Baloo Indexer"

#
# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 43
msgid "Disables the Baloo file indexer. Avoids disk I/O overhead."
msgstr "Disables the Baloo file indexer. Avoids disk I/O overhead."

#
# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 51
msgid "Unload S.M.A.R.T Monitor"
msgstr "Unload S.M.A.R.T Monitor"

#
# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 52
msgid "Disables S.M.A.R.T disk monitoring. Reduces disk I/O and CPU usage."
msgstr "Disables S.M.A.R.T disk monitoring. Reduces disk I/O and CPU usage."

#
# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 60
msgid "Meltdown Mitigations off"
msgstr "Meltdown Mitigations off"

#
# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 62
msgid "Using mitigations=off will make your machine faster and less secure!"
msgstr "Using mitigations=off will make your machine faster and less secure!"

#
# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 67
msgid ""
"This will disable CPU security mitigations (Meltdown/Spectre). Your system "
"will be faster but vulnerable to hardware-level attacks. Are you sure you "
"want to continue?"
msgstr ""
"This will disable CPU security mitigations (Meltdown/Spectre). Your system "
"will be faster but vulnerable to hardware-level attacks. Are you sure you "
"want to continue?"

#
# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 74
msgid "noWatchdog"
msgstr "noWatchdog"

#
# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 76
msgid ""
"Disables the hardware watchdog and TSC clocksource systems, maintaining high "
"performance but removing automatic protections against system crashes."
msgstr ""
"Disables the hardware watchdog and TSC clocksource systems, maintaining high "
"performance but removing automatic protections against system crashes."

#
# File: usr/share/biglinux/biglinux-settings/performance_page.py, line: 81
msgid ""
"This will disable the hardware watchdog. Your system will no longer "
"automatically recover from certain types of crashes. Are you sure you want "
"to continue?"
msgstr ""
"This will disable the hardware watchdog. Your system will no longer "
"automatically recover from certain types of crashes. Are you sure you want "
"to continue?"

