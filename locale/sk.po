# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 72
msgid "Automatic Suspend"
msgstr "Automatické uspanie"
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 73
msgid "Choose when inactivity and low battery may suspend the system."
msgstr "Vyberte, kedy môže nečinnosť a slabá batéria uspať systém."
msgid "Disable idle suspend while plugged in"
msgstr "Zakázať uspatie pri nečinnosti počas napájania zo siete"
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 81
msgid "Disables automatic suspend caused by inactivity on AC power."
msgstr ""
"Zakáže automatické uspanie spôsobené nečinnosťou pri napájaní zo siete."
msgid "Disable idle suspend on battery"
msgstr "Zakázať uspatie pri nečinnosti počas napájania z batérie"
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 89
msgid "Keeps the system awake on battery until a critical level is reached."
msgstr ""
"Udržiava systém v prevádzke na batériu, kým sa nedosiahne kritická úroveň."
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 96
msgid "Suspend only when battery reaches 20%"
msgstr "Uspať iba vtedy, keď batéria klesne na 20 %"
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 98
msgid ""
"Disables idle suspend on battery and suspends automatically when the charge "
"reaches 20%."
msgstr ""
"Zakáže uspanie pri nečinnosti na batériu a automaticky uspí systém, keď "
"nabitie dosiahne 20 %."
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 104
msgid ""
"This uses UPower's critical battery policy. Low and critical warnings occur "
"before the suspend action at 20%."
msgstr ""
"Toto používa politiku kritickej batérie UPower. Upozornenia na nízku a "
"kritickú úroveň sa zobrazia pred uspaním pri 20 %."
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 75
msgid "Sleep Mode"
msgstr "Režim spánku"
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 76
msgid "Configure how the system suspends."
msgstr "Nastavte, ako systém pozastavuje."
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 83
msgid "Use s2idle (light sleep)"
msgstr "Použiť s2idle (ľahký spánok)"
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 85
msgid ""
"Uses a lighter sleep mode that preserves Fn keys and device state. "
"Recommended for ASUS notebooks."
msgstr ""
"Používa ľahší režim spánku, ktorý zachováva klávesy Fn a stav zariadenia. "
"Odporúča sa pre notebooky ASUS."
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 91
msgid ""
"S3 deep sleep can cause the Embedded Controller to stop generating hotkey "
"interrupts. s2idle keeps the EC powered, avoiding this issue at a small cost "
"in battery consumption."
msgstr ""
"Hlboký spánok S3 môže spôsobiť, že zabudovaný ovládač prestane generovať "
"prerušenia horúcich klávesov. s2idle udržuje EC napájaný, čím sa vyhýba "
"tomuto problému za malú cenu v spotrebe batérie."
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 100
msgid "WiFi"
msgstr "WiFi"
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 101
msgid "Prevent WiFi issues after suspend."
msgstr "Zabrániť problémom s WiFi po pozastavení."
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 108
msgid "Protect WiFi on suspend"
msgstr "Chrániť WiFi pri pozastavení"
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 110
msgid ""
"Prevents the Realtek WiFi chip from fully powering off (d3cold), avoiding "
"connection loss after resume."
msgstr ""
"Zabraňuje úplnému vypnutiu čipu Realtek WiFi (d3cold), čím sa zabraňuje "
"strate pripojenia po obnovení."
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 116
msgid ""
"Some Realtek RTL8852BE/CE chips fail to reinitialize after d3cold power "
"gating. This keeps the chip in d3hot (PCIe link alive) during suspend."
msgstr ""
"Niektoré čipy Realtek RTL8852BE/CE sa po d3cold vypnutí napájania nedokážu "
"znovu inicializovať. To udržuje čip v d3hot (PCIe link je aktívny) počas "
"pozastavenia."
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 124
msgid "Display and Keyboard"
msgstr "Displej a klávesnica"
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 125
msgid "Preserve brightness and LED state across suspend."
msgstr "Zachovať jas a stav LED počas suspendovania."
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 132
msgid "Save/restore brightness on suspend"
msgstr "Uložiť/obnoviť jas pri pozastavení"
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 134
msgid ""
"Saves screen brightness and keyboard LEDs before suspending and restores "
"them on resume."
msgstr ""
"Uloží jas obrazovky a LED klávesnice pred pozastavením a obnoví ich po "
"obnovení."
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 144
msgid "GNOME Shell Extensions"
msgstr "Rozšírenia GNOME Shell"
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 145
msgid "Automatic health check after resume."
msgstr "Automatická kontrola zdravia po obnovení."
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 152
msgid "Extension health monitor"
msgstr "Monitor zdravia rozšírenia"
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 154
msgid ""
"Detects GNOME Shell extensions in error state after resume and automatically "
"restarts them."
msgstr ""
"Detekuje rozšírenia GNOME Shell v chybovom stave po obnovení a automaticky "
"ich reštartuje."
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 163
msgid "Lid Switch"
msgstr "Prepínač viečka"
# File: usr/share/biglinux/biglinux-settings/sleep_page.py, line: 164
msgid "Laptop lid close behavior."
msgstr "Správanie pri zatvorení veka prenosného počítača."
msgid "Keep running with the lid closed while plugged in"
msgstr "Ponechať notebook spustený so zatvoreným vekom pri napájaní zo siete"
msgid ""
"Keeps the session and network active when the lid is closed on AC power."
msgstr ""
"Ponechá reláciu a sieťové pripojenie aktívne, keď je veko zatvorené počas "
"napájania zo siete."
msgid ""
"This prevents lid-triggered suspend and locking. Automatic idle locking "
"remains separate. Keep the notebook ventilated while it runs with the lid "
"closed."
msgstr ""
"Tým sa zabráni uspatiu a uzamknutiu vyvolanému zatvorením veka. Automatické "
"uzamknutie pri nečinnosti zostáva samostatnou funkciou. Keď notebook pracuje "
"so zatvoreným vekom, zabezpečte jeho dostatočné vetranie."
msgid "Keep running with the lid closed on battery"
msgstr "Ponechať notebook spustený so zatvoreným vekom pri napájaní z batérie"
msgid ""
"Keeps the session and network active when the lid is closed on battery power."
msgstr ""
"Ponechá reláciu a sieťové pripojenie aktívne, keď je veko zatvorené počas "
"napájania z batérie."
msgid ""
"This prevents lid-triggered suspend and locking. Automatic idle locking "
"remains separate, and the 20% critical battery policy still applies."
msgstr ""
"Tým sa zabráni uspatiu a uzamknutiu vyvolanému zatvorením veka. Automatické "
"uzamknutie pri nečinnosti zostáva samostatnou funkciou a pravidlo pre "
"kritický stav batérie pri 20 % zostáva v platnosti."
